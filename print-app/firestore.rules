rules_version = '2';
// checkin-app과 같은 Firebase 프로젝트를 쓴다면 이 파일 전체를 콘솔 규칙 탭에 붙여넣으세요.
// (checkins 규칙이 함께 들어 있어 기존 체크인 앱도 그대로 동작합니다.)
//
// 3D프린터 앱 보안 구조
//  - 학생: 익명 로그인. 자기 요청(ownerUid) 또는 접수번호+비밀번호로 열람권(printGrants)을 얻은 요청만 읽기
//  - 매니저/관리자: 구글 로그인 + printStaff/{이메일} 문서에 등록된 사람만
//  - 공개 현황판: printPublic(가린 이름·학번)만 누구나 읽기. 실명·학번 원본·사진은 비공개
//  - 비밀번호는 저장하지 않고, SHA-256 해시를 문서 ID로 쓰는 printKeys(읽기 불가)로만 확인
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 기존 checkin-app ----
    match /checkins/{studentId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['name', 'days', 'times'])
                   && request.resource.data.name is string
                   && request.resource.data.days is list
                   && request.resource.data.days.size() == 33;
    }

    // ---- 공통 함수 ----
    function signedIn() { return request.auth != null; }
    function staffPath() {
      return /databases/$(database)/documents/printStaff/$(request.auth.token.email);
    }
    function isStaff() {
      return signedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && exists(staffPath());
    }
    function isAdmin() { return isStaff() && get(staffPath()).data.role == 'admin'; }
    function reqPath(reqId) { return /databases/$(database)/documents/printRequests/$(reqId); }
    function hasGrant(reqId) {
      return exists(/databases/$(database)/documents/printGrants/$(request.auth.uid + '_' + reqId));
    }
    // 이 요청의 주인(접수한 기기)이거나 비밀번호로 열람권을 얻은 학생
    function canActAs(reqId) {
      return signedIn() && (get(reqPath(reqId)).data.ownerUid == request.auth.uid || hasGrant(reqId));
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function validStatus(s) {
      return s in ['requested', 'approved', 'printing', 'done', 'received', 'used', 'rejected', 'canceled'];
    }
    function studentTransition() {
      let a = resource.data.status;
      let b = request.resource.data.status;
      return (a in ['requested', 'approved'] && b == 'canceled')
          || (a == 'done' && b == 'received')
          || (a == 'received' && b == 'used');
    }

    // ---- 운영자 명단 ----
    // 첫 관리자는 Firebase 콘솔에서 직접 만듭니다: printStaff/{구글 이메일} = { role: "admin", name: "이름" }
    match /printStaff/{email} {
      allow read: if signedIn() && ((('email' in request.auth.token) && request.auth.token.email == email) || isAdmin());
      allow create, update: if isAdmin()
                            && request.resource.data.role in ['manager', 'admin']
                            && request.resource.data.name is string;
      allow delete: if isAdmin() && request.auth.token.email != email;
    }

    // ---- 요청서 원본 (비공개) ----
    match /printRequests/{reqId} {
      allow read: if isStaff()
                  || (signedIn() && resource.data.ownerUid == request.auth.uid)
                  || (signedIn() && hasGrant(reqId));
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'requested'
                    && request.resource.data.id == reqId
                    && request.resource.data.name is string
                    && request.resource.data.studentNo is string
                    && !('pin' in request.resource.data)
                    && !('phone' in request.resource.data);
      allow update: if validStatus(request.resource.data.status) && (
                       // 관리자: 파기(익명화)를 위해 원본 필드 수정 가능 (주인·접수번호는 변경 불가)
                       (isAdmin() && !changed().hasAny(['ownerUid', 'id', 'createdAt']))
                       // 매니저: 처리 관련 필드만
                    || (isStaff() && changed().hasOnly([
                         'status', 'history', 'rejectReason', 'adminMemo', 'printHours', 'donePhotoCount',
                         'usagePhotoCount', 'usageNote', 'receivedAt', 'doneAt', 'usedAt', 'updatedAt']))
                       // 학생: 취소 / 수령 확인 / 활용 등록만
                    || (canActAs(reqId) && studentTransition() && changed().hasOnly([
                         'status', 'history', 'updatedAt', 'receivedAt', 'usagePhotoCount', 'usageNote', 'usedAt']))
                  );
      allow delete: if false;

      // 출력 완료·활용 사진 (비공개)
      match /photos/{photoId} {
        allow read: if isStaff() || canActAs(reqId);
        allow create: if request.resource.data.data is string
                      && request.resource.data.data.size() < 950000
                      && ((isStaff() && request.resource.data.kind in ['done', 'usage'])
                          || (canActAs(reqId) && request.resource.data.kind == 'usage'));
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---- 공개 현황판용 요약 (가린 이름·학번만) ----
    match /printPublic/{reqId} {
      allow read: if true;
      allow create: if signedIn()
                    && getAfter(reqPath(reqId)).data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'maskedName', 'maskedNo', 'dept', 'cert', 'title', 'date', 'printerId', 'slots',
                         'status', 'updatedAt']);
      allow update: if validStatus(request.resource.data.status) && (
                       isStaff()
                    || (canActAs(reqId) && changed().hasOnly(['status', 'updatedAt'])));
      allow delete: if false;
    }

    // ---- 예약 칸 잠금 (문서 ID = 날짜_장비_칸, 이미 있으면 생성 거부 → 중복 예약 방지) ----
    match /printSlots/{slotId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['requestId', 'date', 'printerId', 'slot', 'createdAt'])
                    && getAfter(reqPath(request.resource.data.requestId)).data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if isStaff()
                    || get(reqPath(resource.data.requestId)).data.status in ['rejected', 'canceled'];
    }

    // ---- 비밀번호 확인용 키: 문서 ID = SHA-256(접수번호:비밀번호). 아무도 읽을 수 없음 ----
    match /printKeys/{keyHash} {
      allow read: if isAdmin();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['requestId', 'createdAt'])
                    && getAfter(reqPath(request.resource.data.requestId)).data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- 열람권: 다른 기기에서 접수번호+비밀번호를 맞히면 생성 가능 ----
    match /printGrants/{grantId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'requestId', 'key', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && grantId == request.auth.uid + '_' + request.resource.data.requestId
                    && exists(/databases/$(database)/documents/printKeys/$(request.resource.data.key))
                    && get(/databases/$(database)/documents/printKeys/$(request.resource.data.key)).data.requestId
                       == request.resource.data.requestId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
