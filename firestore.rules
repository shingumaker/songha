rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /cards/{cardId} {
      allow read: if true;
      allow create: if true;
      // Edits are allowed only if the incoming write echoes back the same
      // editKey already stored on the document (set once at creation and
      // kept in the creator's browser localStorage) — not real auth, but
      // enough to stop casual/accidental overwrites of someone else's card.
      allow update: if request.resource.data.id == resource.data.id
                    && request.resource.data.editKey == resource.data.editKey;
      // Not gated by any per-card secret (unlike update) — deletion is meant
      // to be reachable only through the password-gated /admin page in the
      // app, which is the real protection here; this rule itself trusts
      // anyone making the request, same trust level as the public read rule.
      allow delete: if true;
    }
  }
}
